# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: custom database name (defaults to "nexcode")
MONGODB_DB_NAME=nexcode

# --- Admin users (one access key per user) ---
# Each user gets their own key; the key identifies them in the activity log.
# Add more users by copying the pattern: ADMIN_USER_<ID>_KEY + ADMIN_USER_<ID>_NAME

ADMIN_USER_PASINDU_KEY=change-me-to-a-long-random-string
ADMIN_USER_PASINDU_NAME=Pasindu Hansana

ADMIN_USER_CHAMARA_KEY=change-me-to-another-long-random-string
ADMIN_USER_CHAMARA_NAME=Chamara Perara

# Secret used to sign the admin JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-jwt-signing-secret

# Optional: token lifetime (defaults to 7d)
# JWT_EXPIRES_IN=7d

# Google Gemini API key (used by the AI Assistant).
# Backend-only — the key must never be exposed to the frontend or committed.
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-3.6-flash; falls back to
# other models automatically if the configured one is overloaded or removed)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: AI Assistant rate limiting (per admin user).
# Durable (stored in MongoDB) so it survives serverless cold starts; the
# assistant fails OPEN if the DB is unreachable. Set to 0 to disable a tier.
# AI_RATE_LIMIT_MINUTE_MAX=30
# AI_RATE_LIMIT_DAY_MAX=500

# Optional: port for local `vercel dev` (ignored by Vercel's production runtime)
# PORT=3000
